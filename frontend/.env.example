# Cloud Backend API URL (for Vercel deployment)
# Set this to your deployed backend API URL (e.g., Render, Railway, or Heroku)
# Example: https://insta-backend.onrender.com/api
VITE_API_URL=

# Cloud WebSocket/Socket.IO Server URL (optional)
# Defaults automatically to the origin of VITE_API_URL if not specified
# Example: https://insta-backend.onrender.com
VITE_SOCKET_URL=
