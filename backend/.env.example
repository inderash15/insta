# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend Client Origin
# Supports comma-separated origins and *.vercel.app wildcards
# Example: https://my-insta-app.vercel.app,http://localhost:5173
CLIENT_ORIGIN=https://your-vercel-domain.vercel.app

# Cross-Site Cookie Policy (Required for Vercel <-> Render cross-domain hosting)
# Set to 'none' for production cross-domain, or 'lax' if using reverse proxy or same domain
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# MongoDB Database Connection
# Replace with your MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/insta?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/insta
USE_IN_MEMORY_DB=false

# Security & Secrets (Use strong random strings in production)
JWT_SECRET=replace_with_a_secure_random_string_minimum_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_secure_random_string
ADMIN_REGISTRATION_KEY=replace_with_admin_secret_key_for_privileged_users

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_BYTES=15728640
MAX_VIDEO_SIZE_BYTES=104857600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
