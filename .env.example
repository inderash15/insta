# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (Dual mode: connects to MONGODB_URI if available, otherwise spins up embedded mongodb-memory-server)
MONGODB_URI=mongodb://127.0.0.1:27017/insta
USE_IN_MEMORY_DB=auto

# Security & Sessions
JWT_SECRET=insta_jwt_development_secret_key_minimum_32_characters_long_12345
JWT_EXPIRES_IN=7d
COOKIE_SECRET=insta_cookie_signing_secret_key_987654321
CORS_ORIGIN=http://localhost:5173

# Media Upload Storage
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_BYTES=15728640
MAX_VIDEO_SIZE_BYTES=104857600

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Initial Admin Bootstrap
ADMIN_REGISTRATION_KEY=insta_admin_master_setup_key_2026
